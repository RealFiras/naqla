<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Naqla.Core/Naqla.Core.csproj" /></ItemGroup>
  <PropertyGroup><NaqlaComponentCatalogPath Condition="'$(NaqlaComponentCatalogPath)' == ''">../../assets/component-catalog.json</NaqlaComponentCatalogPath></PropertyGroup>
  <ItemGroup><EmbeddedResource Include="$(NaqlaComponentCatalogPath)" LogicalName="Naqla.ComponentCatalog.json" Condition="Exists('$(NaqlaComponentCatalogPath)')" /><InternalsVisibleTo Include="Naqla.Tests" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- 6.2.4 is MIT; later releases have different licensing. Review before upgrading. -->
    <PackageReference Include="PDFsharp-WPF" Version="[6.2.4]" />
    <PackageReference Include="SharpCompress" Version="[0.50.5]" />
    <PackageReference Include="Tesseract" Version="[5.2.0]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="[1.30.0]" />
    <PackageReference Include="AngleSharp" Version="[1.8.5]" />
  </ItemGroup>
</Project>
